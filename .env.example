# ===================================
# VARIABLES DE ENTORNO - EJEMPLO
# ===================================
# Copia este archivo a .env y configura tus valores reales
# IMPORTANTE: Nunca subas el archivo .env a git

# ===================================
# BASE DE DATOS SQL SERVER
# ===================================
DB_SERVER=tu-servidor.database.windows.net
DB_DATABASE=Cobranza
DB_USER=tu-usuario
DB_PASSWORD=tu-password-segura

# ===================================
# AUTENTICACIÓN
# ===================================
JWT_SECRET=tu-secreto-jwt-super-seguro-cambia-esto

# ===================================
# API (Opcional)
# ===================================
# VITE_API_URL=https://tu-dominio.netlify.app

# ===================================
# DEMO DE COBRANZA (Reportes > Demo)
# ===================================
# Tu celular: es el cliente demo 1 (los demás son ficticios o prospectos de la expo)
DEMO_CELULAR_REAL=
# Nombre con el que te saluda el bot (opcional)
DEMO_NOMBRE_REAL=
# Organización de la cuenta demo berniluck@gmail.com (la imprime scripts/crear-demo-berniluck.mjs)
DEMO_ORGANIZACION_ID=
# Bot de WhatsApp que manda los cobros (carpeta bot-cobranza-demo)
BOT_COBRANZA_URL=http://localhost:3010
BOT_COBRANZA_TOKEN=

# Botón "Ver Cobranza" de la demo de AICuenta (misma clave en AICuenta)
DEMO_SSO_SECRET=
